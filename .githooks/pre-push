#!/usr/bin/env bash
set -euo pipefail

readonly zero=0000000000000000000000000000000000000000
readonly remote_name="${1:-origin}"

base_for() {
  local local_sha=$1 candidate

  for candidate in \
    "$(git symbolic-ref --quiet "refs/remotes/${remote_name}/HEAD" 2>/dev/null || true)" \
    "refs/remotes/${remote_name}/main" \
    "refs/remotes/${remote_name}/master"
  do
    [[ -n "${candidate}" ]] || continue
    git rev-parse --verify "${candidate}^{commit}" >/dev/null 2>&1 || continue
    git merge-base "${local_sha}" "${candidate}"
    return
  done

  git hash-object -t tree /dev/null
}

lint_ref() (
  local local_sha=$1 remote_sha=$2 base work snapshot path markdownlint node zig
  local -a markdown=() sources=() archive=()

  [[ "${local_sha}" != "${zero}" ]] || return 0
  if [[ "${remote_sha}" == "${zero}" ]]; then
    base=$(base_for "${local_sha}")
  else
    base=${remote_sha}
  fi

  work=$(mktemp -d "${TMPDIR:-/tmp}/irregex-pre-push.XXXXXX")
  trap 'rm -rf "${work}"' EXIT
  git diff --name-only -z --diff-filter=ACMR "${base}" "${local_sha}" -- '*.md' '*.zig' >"${work}/paths"
  while IFS= read -r -d '' path; do
    case "${path}" in
      *.md) markdown+=("${path}") ;;
      *.zig) sources+=("${path}") ;;
    esac
  done <"${work}/paths"
  ((${#markdown[@]} + ${#sources[@]})) || return 0

  snapshot=${work}/tree
  mkdir "${snapshot}"
  if ((${#markdown[@]})); then
    archive+=("${markdown[@]}")
  fi
  if ((${#sources[@]})); then
    archive+=("${sources[@]}")
  fi
  if git cat-file -e "${local_sha}:.markdownlint-cli2.jsonc" 2>/dev/null; then
    archive+=(.markdownlint-cli2.jsonc)
  fi
  # Resolve tools from the same committed snapshot as the checked files. Mise
  # checks the native lock's sidecar digest and installs its complete graph;
  # an absent lock must fail rather than silently resolve today's npm graph.
  archive+=(.mise.toml mise.lock .mise/locks/npm-markdownlint-cli2)
  git archive "${local_sha}" -- "${archive[@]}" | tar -x -C "${snapshot}"

  command -v mise >/dev/null 2>&1 || {
    printf 'pre-push: mise is required to run locked source discipline\n' >&2
    return 1
  }
  (
    cd "${snapshot}"
    export MISE_TRUSTED_CONFIG_PATHS="${snapshot}"
    if ((${#sources[@]})); then
      printf 'pre-push: checking %d Zig AST(s) at %.12s\n' "${#sources[@]}" "${local_sha}"
      mise install --locked -j 1 zig
      zig=$(mise which --tool zig zig)
      for path in "${sources[@]}"; do
        "${zig}" ast-check "./${path}"
      done
    fi
    if ((${#markdown[@]})); then
      printf 'pre-push: linting %d Markdown file(s) at %.12s\n' "${#markdown[@]}" "${local_sha}"
      mise install --locked -j 1 node npm:markdownlint-cli2
      node=$(mise which --tool node node)
      export PATH="${node%/*}:${PATH}"
      markdownlint=$(mise which --tool npm:markdownlint-cli2 markdownlint-cli2)
      "${markdownlint}" --no-globs -- "${markdown[@]}"
    fi
  )
)

while read -r _local_ref local_sha _remote_ref remote_sha; do
  lint_ref "${local_sha}" "${remote_sha}"
done
