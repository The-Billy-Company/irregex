# Every tracked shell file is Bash. Follow local helpers, then add only the
# optional checks this benchmark corpus already satisfies. The stricter
# bracket, brace, and masked-return checks would be a style migration, not a
# lint configuration; they stay out until that migration lands.
shell=bash
external-sources=true
source-path=SCRIPTDIR
enable=avoid-nullary-conditions
enable=check-sourced
enable=deprecate-which
enable=useless-use-of-cat

# SC2034 cannot see that field.sh is vendored, byte-identical apparatus
# (bench/apparatus/SHARED.sha256): the face package's own
# bench/dominance/races/field.sh sources it and reads
# SCOPE/HAVE_RG/HAVE_UGREP/HAVE_AG/HAVE_GGREP/HAVE_GITGREP to build its race
# rosters, but irregex carries no races of its own to read them back — the same
# false positive that package's .shellcheckrc already disables.
disable=SC2034
