.{
    .name = .irregex,
    .version = "2.7.0", // x-release-please-version
    .fingerprint = 0x418e7555d884a859,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // The shard-aware test runner. Build-time only, no artifact, no ABI —
        // it decides which tests a process owns and hangs the `Run` steps off
        // one compiled binary. Pinned by url+hash like everything else here,
        // rather than reached at `../brigade`: a sibling path resolves on the
        // machine that has the sibling and nowhere else, so a clone — CI's
        // included — could not build this package at all. Not `.lazy`, because
        // unlike the vendored engines below this one really is fetched.
        .brigade = .{
            .url = "https://github.com/The-Billy-Company/brigade/archive/refs/tags/v0.2.0.tar.gz",
            .hash = "brigade-0.2.0-1n1fSbc8AQAg_nOUnefJ5uEVkoUBSeba6M6TYjjIV3I-",
        },
        // PCRE2 10.49 — the opt-in `-P` engine. The build compiles the pinned
        // mirror physically vendored under vendor/pcre2/ (hermetic, offline,
        // byte-reproducible), so this entry is `.lazy` and is NEVER fetched by
        // `zig build`. It exists to pin the exact upstream release by URL +
        // content hash — the machine-checkable provenance the supply-chain
        // ledger records as a trust edge (contracts/trust/supply-chain/
        // ledger.toml, zig/pcre2). To re-vendor, `zig fetch --save` the next
        // release and refresh vendor/pcre2/ + the ledger row together.
        .pcre2 = .{
            .url = "https://github.com/PCRE2Project/pcre2/releases/download/pcre2-10.49/pcre2-10.49.tar.gz",
            .hash = "pcre2-10.49.0-IZ6r68cregBKN199ndY6AaKNyKJpNmnQVSm8-h0gp4sj",
            .lazy = true,
        },
        // libsais 2.10.4 — the suffix sort under the FM-index. The bytes that
        // build live under vendor/libsais/; this `.lazy` entry only pins the
        // upstream release by URL + content hash.
        .libsais = .{
            .url = "https://github.com/IlyaGrebnov/libsais/archive/refs/tags/v2.10.4.tar.gz",
            .hash = "N-V-__8AAMp_GQAZXZSkM8FirhH5VFPH4NpLYN6AOMg2foBt",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        // The shared measurement instruments — the 12-class probe registry, the
        // PMU counters, and the bootstrap/Mann-Whitney verdict math — exported
        // as the `probes` / `pmu` / `stats` modules. Here for the same reason
        // `brigade.zig` is: a face's bench harness reaches them through its
        // dependency on this package, and one shared registry is what makes a
        // class name mean the same thing in both repos' numbers.
        "bench/apparatus/harness",
        "src",
        "vendor",
        "README.md",
        "CHANGELOG.md",
        "LICENSE",
        "NOTICE",
    },
}
