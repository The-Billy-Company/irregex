// irregex — import topology.
//
// The prose version of this file is src/README.md and the per-tier READMEs.
// This is the machine-checkable half: Zig has no visibility rules between
// files inside a package, so every boundary those READMEs describe is
// convention until it is written here. Judged by `make lint-zig-arch`.

package irregex {
    // root.zig is the module's public face: it re-exports every tier through
    // the flat C ABI and aggregates the test step, so it alone may reach
    // anywhere.
    root   src
    facade root.zig
}

// Tiers, low to high. Reading down this block is reading up the architecture;
// an import may only point back up the page.
//
// The stack is declared at the granularity the architecture actually has, not
// at the granularity of the top-level folders. `kernel/` is eleven tiers, not
// one: collapsing them would have let `math` grow a dependency on `compose`
// and called it legal. Two corpus packages likewise sit OUT of their folder's
// place on the page — `corpus/index/frame/` is the wire floor everything
// persisted stands on, and `corpus/index/trigrams/` is below the freshness
// fold that reads its persisted pair. A tier is the unit of "may not point
// up" — so wherever direction is meant, there is a tier.
tiers {
    // Platform floor — std only, and below even the instrumentation because it
    // is what the instrumentation writes *through*. One file holding every
    // primitive whose spelling differs across an OS (handle-relative open, the
    // whole-file map, stat, realpath, argv, stdin readiness), so the Windows
    // fork is stated once at the bottom of the stack instead of appearing as a
    // `builtin.os` branch in whichever tier happened to need it.
    portal      portal.zig

    // Instrumentation floor — std only, so every tier above can consume it
    // without inversion.
    assay       assay/**

    // The error taxonomy (ADR-373). Above assay only because it reports
    // through it.
    fault       fault.zig

    // The wire floor: framing primitives (`frame.zig`), the one artifact
    // digest (`signet.zig`), and the artifact home (`home.zig`). It lives
    // under `corpus/index/` on disk because that is what it frames, but it
    // sits HERE on the page because the codex kernel seals its payloads and
    // the crest sieve stamps its schema with the same signet the corpus
    // artifacts use — pure byte discipline, no corpus knowledge.
    frame       corpus/index/frame/**

    // ── Pure compute. No argv, no walk, no emit. ────────────────────────────

    // The math floor — bit tricks, hash mixing, parallel fan-out, the glob
    // matcher, the crest sieve, edit distance, the disjoint-set forest, the
    // hash-consed DAG, the succinct structures: arithmetic and structure with
    // no product opinion.
    math        kernel/math/**

    // The SIMD scanners and the literal-lane vocabulary they share with the
    // regex composer.
    scan        kernel/scan/**

    // The regex package — parser, linear engines, PCRE2 bridge, symbolic and
    // bit-parallel rungs, and the meta dispatcher. One grammar, one seal.
    regex       kernel/regex/**

    // The shared compiled query every transport compiles through.
    query       kernel/query/**

    // Result fusion + per-language definition signals over matches.
    rank        kernel/rank/**

    // Many patterns in one walk, and the woven plan over them.
    slate       kernel/slate/**

    // Source anatomy — comment spans, identifier tokens, structural leans.
    anatomy     kernel/anatomy/**

    // Compression-as-similarity: sketches, silhouettes, recall, clustering.
    kinship     kernel/kinship/**

    // The compression codebook (FM-index, wavelet, RRR, SA-IS) — seals its
    // persisted payload with the wire floor's framing.
    codex       kernel/codex/**

    // Set algebra over candidate sets — the composition tier, so it is the
    // only kernel tier allowed to know all the others.
    compose     kernel/compose/**

    // ── Which bytes are eligible, and the artifacts built over them. ────────

    // Path eligibility: the charter, ignore precedence, the path filter.
    scope       corpus/scope/**

    // Byte legibility: encodings, inode identity — is this file readable text.
    read        corpus/read/**

    // The walk itself, the corpus it materializes, and the stdout cadence
    // (`drain.zig`) behind the corpus's own `writeStdout` seam.
    tree        corpus/tree/**

    // The persisted sub-blobs the trigram pair composes: varint posting
    // bodies, and the crest sidecar carrying the sieve's vectors.
    postings    corpus/index/postings/**
    crest       corpus/index/crest/**

    // The persisted trigram pair — above the blobs it composes, below the
    // freshness fold that reads the pair's layout to prove it current.
    trigrams    corpus/index/trigrams/**

    // Freshness: the build anchor, the amend journal, the sweep — what makes
    // a days-old artifact still answer correctly.
    fresh       corpus/fresh/**

    // Every other persisted artifact over the corpus — atlas, content shard,
    // crest sidecar, fragment atlas, phantom map, postings, codex shelf.
    // Uses kernel math to build them and the freshness fold to trust them.
    index       corpus/index/atlas/** corpus/index/content/** corpus/index/frag/** corpus/index/phantom/** corpus/index/shelf/**

    // ── Surface: vocabulary, then transports, then faces. ───────────────────

    // Shared flag, emit, manifest and outcome vocabulary — the floor both the
    // engines and the faces stand on.
    cli         surface/cli/**

    // The cold transport: argv in, bytes out, one process per query.
    cold        exec/cold/**

    // Kinship retrieval over the persisted artifacts — the fingerprint
    // lexicon path `relate similar`/`pack` ride, shared by cold and warm.
    retrieval   exec/retrieval/**

    // The warm resident session over the cold engine's per-file path — the
    // one place a query outlives a process. Owns the daemon transport
    // (`daemon/client`, `daemon/serve`) since the ADR-352 move.
    session     exec/session/**

    // The analytic plane's Zig-side API, driving the session from above.
    api         surface/api.zig surface/api_test.zig

    // C-ABI session + analytic plane over the api tier.
    ffi         surface/ffi/**

    // The three thin product faces (gist · relate · irregex). A face imports
    // the engines; an engine never imports a face.
    face        surface/face/**
}

// Guest lists: regions only the named importers may reach at all.
//
// Tiers order the stack; they say nothing about peers, because peers at one
// height are unordered by construction. `keep` is where that silence ends —
// the sibling independence the tier block structurally cannot express. Two
// importers are always implicit and need no naming: the region's own insiders,
// and a file's directory sibling (Zig's `render.zig` → `render_test.zig` test
// aggregation is not an architectural crossing).

// The three product faces are peers, not a stack. Each is one product with its
// own CLI contract, and the whole point of three faces over one kernel is that
// a change to gist's verbs cannot reach relate's. When two faces need the same
// thing, it belongs under them, not in whichever one wrote it first.
keep surface/face/gist/**    to root.zig
keep surface/face/relate/**  to root.zig
keep surface/face/irregex/** to root.zig

// The C-ABI plane is the module's other public face — for callers outside Zig.
// Nothing inside the module consumes its own FFI shims; a Zig caller that
// wants the session takes `api.zig`, which is what ffi itself does.
keep surface/ffi/** to root.zig

// The hosted analytic API is entered by the FFI plane and by root's test
// aggregator. An engine reaching back up to it would invert the stack the
// tier block already forbids; naming it here says who the surface is *for*.
keep surface/api.zig to surface/ffi/** root.zig

// Tests are consumers of the architecture, never load-bearing in it. root.zig
// is the aggregator `zig build test` enters through; a production file
// elsewhere in the tree importing a `_test.zig` or a fuzz harness would make a
// fixture part of the build graph. (A file's own directory sibling is implicit
// — `render.zig` beside `render_test.zig` is Zig's aggregation idiom, not an
// architectural crossing.)
keep **/*_test.zig to root.zig
keep **/*_fuzz.zig to root.zig

// Seals: directories that are deep modules — enter by the entry file.
//
// Only directories that hold this today are listed. `ward status` prints the
// two other lists: what is sealable for free right now, and the entry-file
// bypass count for everything still open. Both are burndown queues, not
// failures. (`corpus/index/frame/` is deliberately NOT sealed: it is the wire
// floor, three peer entry points — `frame.zig`, `signet.zig`, `home.zig` —
// not one deep module.)

// The instrumentation floor's whole point is one import for every call site;
// span/tally/channel are its internals.
seal assay through assay.zig

// The kinship atlas is a persisted format — callers get the reader, never the
// on-disk layout.
seal corpus/index/atlas through atlas.zig

// The fragment atlas, same contract as its sibling atlas.
seal corpus/index/frag through frag.zig

// Output shaping — the display grid, the skim window, the multi-buffer writer,
// the replacement pass. `render.zig` asks for shaped bytes; which of the five
// files shapes them is not its business.
seal exec/cold/emit/output through output.zig

// The regex engine is one deep module, and its correctness rests on every
// consumer sharing ONE notion of what a pattern means. The crest sieve proved
// the cost of the alternative: it carried a second, smaller parser whose
// grammar disagreed with this one on the zero-width `\<` / `\>` boundaries,
// and silently pruned two thirds of the matching corpus. This seal is how
// "there is exactly one grammar" stops being a claim — a fork cannot reach the
// internals it would need, and anything wanting the AST must ask the entry
// file. Competition for this engine is other engines (Rust `regex`, RE2,
// PCRE2), measured in bench/; never a second parser inside this tree.
seal kernel/regex through regex.zig

// The shared search core. Every transport compiles through this one name so
// they cannot drift on what a hit is.
seal kernel/query through query.zig

// Filesystem watching is per-platform (kqueue today); the platform pick must
// not leak into callers.
seal exec/session/watch through watch.zig

// The resident session's wire grammar is a cross-language contract — the Zig
// CLI, the Rust binding and the Python binding all speak it — and every frame
// it defines is gated on one negotiated `protocol_version`. Split into the
// opcode spine plus a codec chapter per opcode family (query · result · keep ·
// annals), it is entered as one so a caller binds to the whole versioned
// contract rather than to half of it.
seal exec/session/conduit/protocol through protocol.zig

// Daemon dial + spawn is one decision; a caller that reaches spawn directly
// bypasses the fail-open deadline.
seal exec/session/daemon/client through client.zig

// The resident session's serve loop — split into route/answer/crew/loop,
// entered as one.
seal exec/session/daemon/serve through serve.zig

// (The gist schema and status verbs are single flat files under
// `surface/face/gist/verbs/` since the restructure — a one-file verb has no
// internals to seal, so their former directory seals are gone.)

// Structural laws.
limit  reach to 5 hops
forbid cycles across directories

// Ratified exceptions.
//
// Every one carries the fix that would retire it. An exception that stops
// matching is a hard failure, so paying the debt forces deleting the entry —
// they shrink instead of accreting as folklore.

// ── The resident answer keep's three edges. One fact stated three ways: the
// answer keep is shared CLI vocabulary (`outcome.depart` seals it on every
// exit), but the transport it rides lives two tiers up in the session.

allow tier surface/cli/reprise.zig -> exec/session/daemon/client/keep.zig
    because
        \\The answer keep is a passenger on the resident daemon: it never
        \\starts one, it only dials an existing socket to ask whether this
        \\exact question was already answered against these exact bytes. It
        \\lives in `cli/` because `outcome.depart` — the exit path every
        \\process shares — is what seals an answer in, but the transport it
        \\dials is the session's. Retire by giving the keep's frame types a
        \\home below `cli` (or moving reprise into the session and handing
        \\outcome a callback), after which `cli` depends on nothing above
        \\itself.

allow tier surface/cli/reprise.zig -> exec/session/daemon/serve/serve.zig
    because "Reads the serve loop's frame vocabulary. Retire with the reprise move above."

allow seal surface/cli/reprise.zig -> exec/session/daemon/client/keep.zig
    because
        \\`client/` is sealed through `client.zig` so no caller can skip the
        \\fail-open dial deadline. This reaches `keep.zig` beside it for the
        \\keep's own frame types, not to dial — the deadline is untouched.
        \\Retire either by re-exporting those types from `client.zig`, or with
        \\the reprise move above, whichever lands first.

allow cycle {
    kernel/regex/linear/ladder/verdict.zig
    kernel/regex/linear/pike/scratch.zig
    kernel/regex/linear/pike/search.zig
    kernel/regex/linear/pike/span.zig
    kernel/regex/linear/program/core.zig
} because
        \\`program/core.zig` is the linear engine's interface: it owns the
        \\compiled program every executor reads and re-exports its neighbors'
        \\entry points (`verdict.lineMatch`, `verdict.docMatch`) so callers face
        \\one name. The pike executors and the ladder in turn read the program
        \\they run. The cycle is that facade, not a tangle. Retire by lifting the
        \\shared program representation into a leaf both sides import, leaving
        \\`core.zig` a pure re-exporter.

allow cycle {
    exec/cold/engine/serial.zig
    exec/cold/engine/swarm/swarm.zig
} because
        \\Work distribution recursion: `serial` hands a multi-file query to
        \\`swarm`, and each swarm worker runs the identical per-file path back in
        \\`serial`, which is what keeps the parallel and sequential answers
        \\byte-identical. Retire by extracting that per-file path into a leaf both
        \\import.

allow cycle {
    exec/session/answer/gather.zig
    exec/session/facet/fold.zig
    exec/session/facet/present.zig
    exec/session/facet/stream.zig
    exec/session/reconcile/reconcile.zig
    exec/session/warm/resident.zig
} because
        \\The warm session's real tangle, and the largest one here:
        \\`resident.zig` drives fold/present/stream and reconcile, and all four
        \\read resident state back. Four directories are therefore one indivisible
        \\unit — the session cannot be re-cut without moving all of them. Unlike
        \\the two cycles above this is debt, not a facade. Retire by giving the
        \\resident state a leaf module the facets read instead of importing the
        \\driver.
